 class OpenDuckMiniV2Runner(BaseRunner):
@@ -24,6 +24,7 @@ class OpenDuckMiniV2Runner(BaseRunner):
             "getup_back2": (getup_back2, getup_back2.GetupBack2),
             "getup_back3": (getup_back3, getup_back3.GetupBack3),
             "getup_real": (getup_real, getup_real.GetupReal),
+            "getup_real2": (getup_real2, getup_real2.GetupReal2),
         }
         if args.env not in available_envs:
             raise ValueError(f"Unknown env {args.env}")
