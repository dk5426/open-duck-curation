index 0000000..ef2d4b4
--- /dev/null
+++ b/playground/open_duck_mini_v2/getup_back.py
@@ -0,0 +1,16 @@
+"""Get-up with half of the fallen starts on the back (to learn the back roll-over). Local addition."""
+
+from . import getup
+from .getup import PPO_OVERRIDES, make_randomizer  # noqa: F401
+
+
+def default_config():
+    cfg = getup.default_config()
+    cfg.init_mix.back_share = 0.5
+    return cfg
+
+
+class GetupBack(getup.Getup):
+    # runner.py builds env classes without a config, so the variant's config has to be the class default
+    def __init__(self, task="getup_backlash", config=None, config_overrides=None):
+        super().__init__(task=task, config=config or default_config(), config_overrides=config_overrides)
