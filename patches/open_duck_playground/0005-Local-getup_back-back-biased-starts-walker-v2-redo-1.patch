diff --git a/playground/open_duck_mini_v2/jump2.py b/playground/open_duck_mini_v2/jump2.py
new file mode 100644
index 0000000..602b6d0
--- /dev/null
+++ b/playground/open_duck_mini_v2/jump2.py
@@ -0,0 +1,55 @@
+"""In-place jump, crouch-then-push version. Local addition, not upstream.
+
+jump.py's policy learned to stretch up ~19 mm without leaving the floor. The open-loop bound (tools/feasibility_gifs.py)
+got 8-10 ms airborne only with a deep crouch followed by full extension, so this version shapes exactly that: a
+0.6 s trigger window whose first CROUCH_STEPS (0.24 s) pay for lowering the base up to 4 cm below standing, and whose
+remaining 0.36 s pay strongly for upward base speed, both soles off the floor and base height. Outside the window it
+is jump.py unchanged (stand still at home, no hopping, no drift, falls end the episode, reward clipped at 0).
+Second change vs jump.py: torso CoM randomization +-1 cm instead of +-5 cm (see make_randomizer).
+"""
+
+import jax.numpy as jp
+
+from . import jump
+from . import getup
+from .getup import STAND_HEIGHT
+
+PPO_OVERRIDES = jump.PPO_OVERRIDES
+CROUCH_STEPS = 12
+
+
+def make_randomizer(mj_model):
+    # +-1 cm torso CoM shift instead of the +-5 cm that jump.py/getup.py train with (upstream's range, which it never
+    # actually applied); a hop that is only a few mm high is not learnable under a ~4 cm CoM wobble.
+    return getup.make_randomizer(mj_model, com_scale=0.2)
+
+
+def default_config():
+    cfg = jump.default_config()
+    s = cfg.reward_config.scales
+    s.crouch = 5.0
+    s.up_vel = 20.0
+    s.air = 50.0
+    s.jump_height = 20.0
+    return cfg
+
+
+class Jump2(jump.Jump):
+    window_steps = 30
+
+    def __init__(self, task="getup_backlash", config=None, config_overrides=None):
+        super().__init__(task=task, config=config or default_config(), config_overrides=config_overrides)
+
+    def _get_reward(self, data, action, info, contact):
+        r = super()._get_reward(data, action, info, contact)
+        on, since = self._trigger(info)
+        crouch = (on & (since < CROUCH_STEPS)).astype(jp.float32)
+        push = (on & (since >= CROUCH_STEPS)).astype(jp.float32)
+        h = data.qpos[self._floating_base_qpos_addr + 2]
+        vz = data.qvel[self._floating_base_qvel_addr + 2]
+        airborne = (~contact.any()).astype(jp.float32)
+        r["crouch"] = crouch * jp.clip((STAND_HEIGHT - h) / 0.04, 0.0, 1.0)
+        r["up_vel"] = push * jp.clip(vz, 0.0, 1.0)
+        r["air"] = push * airborne
+        r["jump_height"] = push * jp.clip((h - 0.16) / 0.03, 0.0, 1.0)
+        return r
