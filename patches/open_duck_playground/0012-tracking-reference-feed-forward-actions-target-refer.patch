From a6656294c9bbfbf8f2628b1e590fed26467d2c54 Mon Sep 17 00:00:00 2001
From: Dhawal Kabra <dk5426@nyu.edu>
Date: Tue, 10 Nov 2026 01:21:17 -0500
Subject: [PATCH] tracking: reference feed-forward actions (target = reference
 + 0.25 * action), TRACKING_OVERRIDES env var

---
 playground/open_duck_mini_v2/tracking.py | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/playground/open_duck_mini_v2/tracking.py b/playground/open_duck_mini_v2/tracking.py
index 1bdd83d..3aca6f7 100644
--- a/playground/open_duck_mini_v2/tracking.py
+++ b/playground/open_duck_mini_v2/tracking.py
@@ -54,6 +54,9 @@ def default_config() -> config_dict.ConfigDict:
         episode_length=200,
         action_repeat=1,
         action_scale=0.25,
+        # Joint targets = reference pose + action_scale * action (zero action replays the clip); False = home pose +
+        # action_scale * action, as in the walker. Pilot 1 and the first v4 scoring run (home-based) learned to stand.
+        ref_feedforward=True,
         dof_vel_scale=0.05,
         max_motor_velocity=5.24,
         rsi_prob=0.5,           # reference-state initialisation: start mid-clip half the time
@@ -114,8 +117,10 @@ class Tracking(open_duck_mini_v2_base.OpenDuckMiniV2Env):
 
     def __init__(self, task: str = "flat_terrain_backlash", config: config_dict.ConfigDict = None,
                  config_overrides: Optional[Dict[str, Union[str, int, list[Any]]]] = None, clip_ids=None):
+        # TRACKING_OVERRIDES: JSON of flattened config keys, e.g. '{"reward_config.sigma.legs": 0.3}', for ablations
+        env_over = json.loads(os.environ.get("TRACKING_OVERRIDES", "{}"))
         super().__init__(xml_path=constants.task_to_xml(task).as_posix(), config=config or default_config(),
-                         config_overrides=config_overrides)
+                         config_overrides={**env_over, **(config_overrides or {})} or None)
         for side in ("left", "right"):  # knee range as measured on the robot (the clip library is checked against it)
             self._mj_model.jnt_range[self._mj_model.joint(f"{side}_knee").id] = [-KNEE_LIMIT, KNEE_LIMIT]
             self._mj_model.actuator_ctrlrange[self._mj_model.actuator(f"{side}_knee").id] = [-KNEE_LIMIT, KNEE_LIMIT]
@@ -270,7 +275,8 @@ class Tracking(open_duck_mini_v2_base.OpenDuckMiniV2Env):
         idx = jax.random.randint(k_delay, (1,), self._config.noise_config.action_min_delay,
                                  self._config.noise_config.action_max_delay)
         act = hist.reshape((-1, self._nu))[idx[0]]
-        tgt = jp.clip(self._default_actuator + act * self._config.action_scale, self._ctrl_lo, self._ctrl_hi)
+        base_q = self._ref(info["clip"], info["frame"] + 1)["q"] if self._config.ref_feedforward else self._default_actuator
+        tgt = jp.clip(base_q + act * self._config.action_scale, self._ctrl_lo, self._ctrl_hi)
         lim = self._config.max_motor_velocity * self.dt
         tgt = jp.clip(tgt, info["motor_targets"] - lim, info["motor_targets"] + lim)
         data = mjx_env.step(self.mjx_model, state.data, tgt, self.n_substeps)
-- 
2.50.1

