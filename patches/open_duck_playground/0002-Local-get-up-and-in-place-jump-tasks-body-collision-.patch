+# Copyright 2025 DeepMind Technologies Limited
+# Copyright 2025 Antoine Pirrone - Steve Nguyen
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ==============================================================================
+"""Get-up (fall recovery) task for Open Duck Mini V2. Local addition, not upstream.
+
+Starts from fallen poses (a precomputed bank of drops onto the floor), mid-fall states (standing with a large push)
+and standing states, and rewards getting the trunk upright, the base back to standing height and the joints back to
+the home pose, then holding still. No termination on falling. Roll-overs (back/side -> front/feet) are part of it.
+
+Needs the scene with body collision boxes (tools/make_getup_model.py -> scene_getup_backlash.xml) and the start-state
+bank (tools/make_getup_bank.py -> data/getup_init_bank.npz).
+
+Observation (what the real robot has; 92 dims): gyro 3, accelerometer 3, joint pos - home 14, 0.05 * joint vel 14,
+last 3 actions 42, motor targets 14, foot contacts 2. Actions: targets = home + action_scale * action, clipped to the
+joint ranges and to the 5.24 rad/s motor speed limit. action_scale is 1.0 (the walker's 0.25 cannot reach the poses a
+get-up needs).
+"""
+
+from typing import Any, Dict, Optional, Union
+
+import jax
+import jax.numpy as jp
+import numpy as np
+from ml_collections import config_dict
+from mujoco import mjx
+from mujoco.mjx._src import math
+
+from mujoco_playground._src import mjx_env
+from mujoco_playground._src.collision import geoms_colliding
+
+from . import constants
+from . import base as open_duck_mini_v2_base
+from playground.common.rewards import cost_torques, cost_action_rate
+
+BANK_PATH = "playground/open_duck_mini_v2/data/getup_init_bank.npz"
+HEAD_BOXES = ["col_head_assembly", "col_neck_yaw_assembly"]
+STAND_HEIGHT = 0.155  # base z standing at home (settles at ~0.160)
+LOW_HEIGHT = 0.05
+
+# PPO overrides read by runner.py: 10 s episodes instead of the walker's 20 s.
+PPO_OVERRIDES = {"episode_length": 500}
+
+
+def default_config() -> config_dict.ConfigDict:
+    return config_dict.create(
+        ctrl_dt=0.02,
+        sim_dt=0.002,
+        episode_length=500,
+        action_repeat=1,
+        action_scale=1.0,
+        dof_vel_scale=0.05,
+        max_motor_velocity=5.24,  # rad/s
+        init_mix=config_dict.create(fallen=0.6, mid_fall=0.2),  # rest = standing
+        noise_config=config_dict.create(
+            level=1.0,
+            action_min_delay=0,
+            action_max_delay=3,
+            scales=config_dict.create(
+                hip_pos=0.03,
+                knee_pos=0.05,
+                ankle_pos=0.08,
+                joint_vel=2.5,
+                gyro=0.1,
+                accelerometer=0.05,
+            ),
+        ),
+        reward_config=config_dict.create(
+            scales=config_dict.create(
+                upright=4.0,
+                height=4.0,
+                pose=3.0,
+                still=1.0,
+                head_contact=-2.0,
+                base_angvel=-0.02,
+                joint_vel=-1.0e-4,
+                torques=-1.0e-3,
+                action_rate=-0.1,
+            ),
+        ),
+    )
+
+
+class Getup(open_duck_mini_v2_base.OpenDuckMiniV2Env):
+    """Get up from the floor and stand still at the home pose."""
+
+    def __init__(
+        self,
+        task: str = "getup_backlash",
+        config: config_dict.ConfigDict = default_config(),
+        config_overrides: Optional[Dict[str, Union[str, int, list[Any]]]] = None,
+    ):
+        super().__init__(
+            xml_path=constants.task_to_xml(task).as_posix(),
+            config=config,
+            config_overrides=config_overrides,
+        )
+        self._post_init()
+
+    def _post_init(self) -> None:
+        self._init_q = jp.array(self._mj_model.keyframe("home").qpos)
+        self._default_actuator = jp.array(self._mj_model.keyframe("home").ctrl)
+        self._ctrl_lo = jp.array(self._mj_model.actuator_ctrlrange[:, 0])
+        self._ctrl_hi = jp.array(self._mj_model.actuator_ctrlrange[:, 1])
+        self._actuators = self._mj_model.nu
+
+        bank = np.load(BANK_PATH)
+        assert bank["qpos"].shape[1] == self._mj_model.nq, "bank built for a different model"
+        self._bank_qpos = jp.array(bank["qpos"])
+
+        self._floor_geom_id = self._mj_model.geom("floor").id
+        self._feet_geom_id = np.array([self._mj_model.geom(n).id for n in constants.FEET_GEOMS])
+        self._head_geom_id = np.array([self._mj_model.geom(n).id for n in HEAD_BOXES])
+
+        qpos_noise_scale = np.zeros(self._actuators)
+        for idx, j in enumerate(self.actuator_names):
+            if "_hip" in j:
+                qpos_noise_scale[idx] = self._config.noise_config.scales.hip_pos
+            elif "_knee" in j:
+                qpos_noise_scale[idx] = self._config.noise_config.scales.knee_pos
+            elif "_ankle" in j:
+                qpos_noise_scale[idx] = self._config.noise_config.scales.ankle_pos
+        self._qpos_noise_scale = jp.array(qpos_noise_scale)
+
+    # ------------------------------------------------------------------ reset
+    def reset(self, rng: jax.Array) -> mjx_env.State:
+        rng, k_mode, k_idx, k_yaw, k_noise, k_push, k_spin = jax.random.split(rng, 7)
+        u = jax.random.uniform(k_mode)
+        mix = self._config.init_mix
+
+        # Fallen: a settled drop from the bank, rotated to a random heading.
+        qpos_fallen = self._bank_qpos[jax.random.randint(k_idx, (), 0, self._bank_qpos.shape[0])]
+        yaw = jax.random.uniform(k_yaw, (1,), minval=-jp.pi, maxval=jp.pi)
+        yaw_quat = math.axis_angle_to_quat(jp.array([0.0, 0.0, 1.0]), yaw)
+        qpos_fallen = qpos_fallen.at[3:7].set(math.quat_mul(yaw_quat, qpos_fallen[3:7]))
+
+        # Standing / mid-fall: home pose with joint noise and a random heading.
+        qpos_stand = self._init_q.at[3:7].set(math.quat_mul(yaw_quat, self._init_q[3:7]))
+        qj = self.get_actuator_joints_qpos(qpos_stand)
+        qj = qj + jax.random.uniform(k_noise, qj.shape, minval=-0.1, maxval=0.1)
+        qpos_stand = self.set_actuator_joints_qpos(qj, qpos_stand)
+
+        is_fallen = u < mix.fallen
+        is_mid = (u >= mix.fallen) & (u < mix.fallen + mix.mid_fall)
+        qpos = jp.where(is_fallen, qpos_fallen, qpos_stand)
+
+        qvel = jp.zeros(self.mjx_model.nv)
+        push = jax.random.uniform(k_push, (2,), minval=-1.0, maxval=1.0)
+        spin = jax.random.uniform(k_spin, (3,), minval=-4.0, maxval=4.0)
+        base_vel = jp.concatenate([push, jp.zeros(1), spin]) * is_mid
+        qvel = self.set_floating_base_qvel(base_vel, qvel)
+
+        ctrl = jp.clip(self.get_actuator_joints_qpos(qpos), self._ctrl_lo, self._ctrl_hi)
+        data = mjx_env.init(self.mjx_model, qpos=qpos, qvel=qvel, ctrl=ctrl)
+
+        info = {
+            "rng": rng,
+            "step": 0,
+            "last_act": jp.zeros(self._actuators),
+            "last_last_act": jp.zeros(self._actuators),
+            "last_last_last_act": jp.zeros(self._actuators),
+            "motor_targets": ctrl,
+            "action_history": jp.zeros(self._config.noise_config.action_max_delay * self._actuators),
+            "start_fallen": is_fallen.astype(jp.float32),
+        }
+        metrics = {}
+        for k, v in self._config.reward_config.scales.items():
+            metrics[f"reward/{k}" if v > 0 else f"cost/{k}"] = jp.zeros(())
+        metrics["upright_frac"] = jp.zeros(())
+        metrics["stood_up"] = jp.zeros(())
+        contact = self._feet_contact(data)
+        obs = self._get_obs(data, info, contact)
+        reward, done = jp.zeros(2)
+        return mjx_env.State(data, obs, reward, done, metrics, info)
+
+    # ------------------------------------------------------------------- step
+    def step(self, state: mjx_env.State, action: jax.Array) -> mjx_env.State:
+        state.info["rng"], k_delay = jax.random.split(state.info["rng"])
+        action_history = jp.roll(state.info["action_history"], self._actuators).at[: self._actuators].set(action)
+        state.info["action_history"] = action_history
+        idx = jax.random.randint(k_delay, (1,), minval=self._config.noise_config.action_min_delay,
+                                 maxval=self._config.noise_config.action_max_delay)
+        action_w_delay = action_history.reshape((-1, self._actuators))[idx[0]]
+
+        targets = jp.clip(self._default_actuator + action_w_delay * self._config.action_scale,
+                          self._ctrl_lo, self._ctrl_hi)
+        prev = state.info["motor_targets"]
+        lim = self._config.max_motor_velocity * self.dt
+        targets = jp.clip(targets, prev - lim, prev + lim)
+
+        data = mjx_env.step(self.mjx_model, state.data, targets, self.n_substeps)
+        state.info["motor_targets"] = targets
+
+        contact = self._feet_contact(data)
+        obs = self._get_obs(data, state.info, contact)
+        done = jp.isnan(data.qpos).any() | jp.isnan(data.qvel).any()
+
+        rewards = self._get_reward(data, action, state.info)
+        rewards = {k: v * self._config.reward_config.scales[k] for k, v in rewards.items()}
+        reward = jp.nan_to_num(sum(rewards.values()) * self.dt)
+
+        state.info["step"] += 1
+        state.info["last_last_last_act"] = state.info["last_last_act"]
+        state.info["last_last_act"] = state.info["last_act"]
+        state.info["last_act"] = action
+        for k, v in rewards.items():
+            scale = self._config.reward_config.scales[k]
+            state.metrics[f"reward/{k}" if scale > 0 else f"cost/{k}"] = v
+        up = self.get_gravity(data)[-1]
+        stood = self._standing_gate(data)
+        state.metrics["upright_frac"] = (up > 0.9).astype(jp.float32)
+        state.metrics["stood_up"] = stood
+
+        state = state.replace(data=data, obs=obs, reward=reward, done=done.astype(reward.dtype))
+        return state
+
+    # ---------------------------------------------------------------- helpers
+    def _feet_contact(self, data: mjx.Data) -> jax.Array:
+        return jp.array([geoms_colliding(data, g, self._floor_geom_id) for g in self._feet_geom_id])
+
+    def _standing_gate(self, data: mjx.Data) -> jax.Array:
+        up = self.get_gravity(data)[-1]
+        h = data.qpos[self._floating_base_qpos_addr + 2]
+        return ((up > 0.85) & (h > 0.8 * STAND_HEIGHT)).astype(jp.float32)
+
+    def _get_obs(self, data: mjx.Data, info: dict[str, Any], contact: jax.Array) -> mjx_env.Observation:
+        nc = self._config.noise_config
+        info["rng"], k1, k2, k3, k4 = jax.random.split(info["rng"], 5)
+        gyro = self.get_gyro(data)
+        noisy_gyro = gyro + (2 * jax.random.uniform(k1, gyro.shape) - 1) * nc.level * nc.scales.gyro
+        acc = self.get_accelerometer(data)
+        noisy_acc = acc + (2 * jax.random.uniform(k2, acc.shape) - 1) * nc.level * nc.scales.accelerometer
+
+        joint_angles = self.get_actuator_joints_qpos(data.qpos)
+        joint_backlash = self.get_actuator_backlash_qpos(data.qpos)
+        for i in self.backlash_idx_to_add:
+            joint_backlash = jp.insert(joint_backlash, i, 0)
+        joint_angles = joint_angles + joint_backlash
+        noisy_angles = joint_angles + (2 * jax.random.uniform(k3, joint_angles.shape) - 1) * nc.level * self._qpos_noise_scale
+        joint_vel = self.get_actuator_joints_qvel(data.qvel)
+        noisy_vel = joint_vel + (2 * jax.random.uniform(k4, joint_vel.shape) - 1) * nc.level * nc.scales.joint_vel
+
+        state = jp.hstack([
+            noisy_gyro,
+            noisy_acc,
+            noisy_angles - self._default_actuator,
+            noisy_vel * self._config.dof_vel_scale,
+            info["last_act"],
+            info["last_last_act"],
+            info["last_last_last_act"],
+            info["motor_targets"],
+            contact,
+        ])
+        head_contact = jp.array([geoms_colliding(data, g, self._floor_geom_id) for g in self._head_geom_id])
+        privileged_state = jp.hstack([
+            state,
+            gyro,
+            acc,
+            self.get_gravity(data),
+            self.get_local_linvel(data),
+            self.get_global_angvel(data),
+            joint_angles - self._default_actuator,
+            joint_vel,
+            data.qpos[self._floating_base_qpos_addr + 2],
+            data.actuator_force,
+            head_contact,
+            info["start_fallen"],
+        ])
+        return {"state": state, "privileged_state": privileged_state}
+
+    def _get_reward(self, data: mjx.Data, action: jax.Array, info: dict[str, Any]) -> dict[str, jax.Array]:
+        up = self.get_gravity(data)[-1]
+        h = data.qpos[self._floating_base_qpos_addr + 2]
+        gate = self._standing_gate(data)
+        qj = self.get_actuator_joints_qpos(data.qpos)
+        vj = self.get_actuator_joints_qvel(data.qvel)
+        head_contact = jp.array([geoms_colliding(data, g, self._floor_geom_id) for g in self._head_geom_id])
+        return {
+            "upright": jp.square((1.0 + up) / 2.0),
+            "height": jp.clip((h - LOW_HEIGHT) / (STAND_HEIGHT - LOW_HEIGHT), 0.0, 1.0),
+            "pose": gate * jp.exp(-jp.sum(jp.square(qj - self._default_actuator)) / 0.5),
+            "still": gate * jp.exp(-0.01 * jp.sum(jp.square(vj))),
+            "head_contact": jp.any(head_contact).astype(jp.float32),
+            "base_angvel": jp.sum(jp.square(self.get_global_angvel(data))),
+            "joint_vel": jp.sum(jp.square(vj)),
+            "torques": cost_torques(data.actuator_force),
+            "action_rate": cost_action_rate(action, info["last_act"]),
+        }
+
+
+def make_randomizer(mj_model):
+    """Upstream's domain_randomize with the body/geom ids looked up by name. Upstream hardcodes FLOOR_GEOM_ID = 0
+    (a trunk mesh, so floor friction is never randomized) and TORSO_BODY_ID = 1 ('base', massless, so the CoM shift
+    does nothing and the +-0.1 kg can make its mass negative)."""
+    from playground.common import randomize
+
+    floor_id = mj_model.geom("floor").id
+    torso_id = mj_model.body("trunk_assembly").id
+
+    def domain_randomize(model, rng):
+        old = (randomize.FLOOR_GEOM_ID, randomize.TORSO_BODY_ID)
+        randomize.FLOOR_GEOM_ID, randomize.TORSO_BODY_ID = floor_id, torso_id
+        try:
+            return randomize.domain_randomize(model, rng)
+        finally:
+            randomize.FLOOR_GEOM_ID, randomize.TORSO_BODY_ID = old
+
+    return domain_randomize
