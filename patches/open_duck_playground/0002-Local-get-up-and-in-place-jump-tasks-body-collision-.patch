Subject: [PATCH 2/9] Local: get-up and in-place jump tasks (body collision
 boxes, fallen-start bank, name-based DR ids)
---
 playground/common/runner.py                   |   4 +
 playground/open_duck_mini_v2/constants.py     |   2 +
 .../data/getup_init_bank.npz                  | Bin 0 -> 1049076 bytes
 playground/open_duck_mini_v2/getup.py         | 319 +++++++++++
 playground/open_duck_mini_v2/jump.py          | 184 ++++++
 playground/open_duck_mini_v2/runner.py        |   7 +-
 .../xmls/open_duck_mini_v2_backlash_getup.xml | 527 ++++++++++++++++++
 .../xmls/scene_getup_backlash.xml             |  79 +++
 8 files changed, 1121 insertions(+), 1 deletion(-)
 create mode 100644 playground/open_duck_mini_v2/data/getup_init_bank.npz
 create mode 100644 playground/open_duck_mini_v2/getup.py
 create mode 100644 playground/open_duck_mini_v2/jump.py
 create mode 100644 playground/open_duck_mini_v2/xmls/open_duck_mini_v2_backlash_getup.xml
 create mode 100644 playground/open_duck_mini_v2/xmls/scene_getup_backlash.xml

diff --git a/playground/common/runner.py b/playground/common/runner.py
index 628f325..2d94372 100644
--- a/playground/common/runner.py
+++ b/playground/common/runner.py
@@ -12,6 +12,7 @@ from flax.training import orbax_utils
 from tensorboardX import SummaryWriter
 
 import os
+import json
 from brax.training.agents.ppo import networks as ppo_networks, train as ppo
 from mujoco_playground import wrapper
 from mujoco_playground.config import locomotion_params
@@ -99,6 +100,9 @@ class BaseRunner(ABC):
         else:
             network_factory = ppo_networks.make_ppo_networks
         self.ppo_training_params["num_timesteps"] = self.num_timesteps
+        self.ppo_training_params.update(getattr(self, "ppo_overrides", {}))
+        # Local: ad-hoc overrides for CPU pipeline tests, e.g. PPO_OVERRIDES_JSON='{"num_envs": 64}'
+        self.ppo_training_params.update(json.loads(os.environ.get("PPO_OVERRIDES_JSON", "{}")))
         print(f"PPO params: {self.ppo_training_params}")
 
         train_fn = functools.partial(
diff --git a/playground/open_duck_mini_v2/constants.py b/playground/open_duck_mini_v2/constants.py
index 821c1fc..569495c 100644
--- a/playground/open_duck_mini_v2/constants.py
+++ b/playground/open_duck_mini_v2/constants.py
@@ -23,6 +23,7 @@ FLAT_TERRAIN_XML = ROOT_PATH / "xmls" / "scene_flat_terrain.xml"
 ROUGH_TERRAIN_XML = ROOT_PATH / "xmls" / "scene_rough_terrain.xml"
 FLAT_TERRAIN_BACKLASH_XML = ROOT_PATH / "xmls" / "scene_flat_terrain_backlash.xml"
 ROUGH_TERRAIN_BACKLASH_XML = ROOT_PATH / "xmls" / "scene_rough_terrain_backlash.xml"
+GETUP_BACKLASH_XML = ROOT_PATH / "xmls" / "scene_getup_backlash.xml"  # local: body collision boxes
 
 
 def task_to_xml(task_name: str) -> epath.Path:
@@ -31,6 +32,7 @@ def task_to_xml(task_name: str) -> epath.Path:
         "rough_terrain": ROUGH_TERRAIN_XML,
         "flat_terrain_backlash": FLAT_TERRAIN_BACKLASH_XML,
         "rough_terrain_backlash": ROUGH_TERRAIN_BACKLASH_XML,
+        "getup_backlash": GETUP_BACKLASH_XML,
     }[task_name]
 
 
