+# ==============================================================================
+"""Simple in-place jump for Open Duck Mini V2. Local addition, not upstream.
+
+Each 4 s episode starts standing. A jump trigger switches on at a random time in [0.5, 2.0] s and stays on for 0.5 s;
+the policy sees the trigger and the time since it switched on. Inside the window it is paid for upward base speed,
+for both soles being off the floor and for base height above standing; outside it, for standing still at the home pose,
+and it is penalised for lifting a foot. Drift and spin are penalised throughout; a fall ends the episode.
+
+Physics bound (tools/feasibility_gifs.py): an open-loop crouch-and-extend gets ~8-10 ms airborne at 0.25 m/s, so expect
+a hop of a few mm, not a leap. Uses the get-up scene (body collision boxes), observations and randomizer.
+
+Observation 94 = get-up's 92 + [trigger on, seconds since trigger].
+"""
+
+from typing import Any, Dict, Optional, Union
+
+import jax
+import jax.numpy as jp
+from ml_collections import config_dict
+from mujoco import mjx
+from mujoco.mjx._src import math
+
+from mujoco_playground._src import mjx_env
+
+from . import getup
+from .getup import make_randomizer  # noqa: F401  (runner looks it up on this module)
+from playground.common.rewards import cost_torques, cost_action_rate
+
+PPO_OVERRIDES = {"episode_length": 200}
+WINDOW_STEPS = 25
+
+
+def default_config() -> config_dict.ConfigDict:
+    cfg = getup.default_config()
+    cfg.episode_length = 200
+    cfg.trigger_range = [0.5, 2.0]
+    cfg.reward_config = config_dict.create(
+        scales=config_dict.create(
+            alive=2.0,
+            up_vel=10.0,
+            air=20.0,
+            jump_height=10.0,
+            pose=2.0,
+            still=1.0,
+            upright=2.0,
+            hop_outside=-2.0,
+            drift=-5.0,
+            yaw_rate=-0.1,
+            torques=-1.0e-3,
+            action_rate=-0.1,
+        ),
+    )
+    return cfg
+
+
+class Jump(getup.Getup):
+    """Jump in place when triggered, land, and stand still."""
+
+    def __init__(
+        self,
+        task: str = "getup_backlash",
+        config: config_dict.ConfigDict = default_config(),
+        config_overrides: Optional[Dict[str, Union[str, int, list[Any]]]] = None,
+    ):
+        super().__init__(task=task, config=config, config_overrides=config_overrides)
+
+    def reset(self, rng: jax.Array) -> mjx_env.State:
+        rng, k_yaw, k_noise, k_trig = jax.random.split(rng, 4)
+        yaw = jax.random.uniform(k_yaw, (1,), minval=-jp.pi, maxval=jp.pi)
+        qpos = self._init_q.at[3:7].set(
+            math.quat_mul(math.axis_angle_to_quat(jp.array([0.0, 0.0, 1.0]), yaw), self._init_q[3:7]))
+        qj = self.get_actuator_joints_qpos(qpos)
+        qpos = self.set_actuator_joints_qpos(qj + jax.random.uniform(k_noise, qj.shape, minval=-0.05, maxval=0.05), qpos)
+        ctrl = jp.clip(self.get_actuator_joints_qpos(qpos), self._ctrl_lo, self._ctrl_hi)
+        data = mjx_env.init(self.mjx_model, qpos=qpos, qvel=jp.zeros(self.mjx_model.nv), ctrl=ctrl)
+        tr = self._config.trigger_range
+        info = {
+            "rng": rng,
+            "step": 0,
+            "trigger_step": jp.round(jax.random.uniform(k_trig, minval=tr[0], maxval=tr[1]) / self.dt).astype(jp.int32),
+            "xy0": qpos[0:2],
+            "last_act": jp.zeros(self._actuators),
+            "last_last_act": jp.zeros(self._actuators),
+            "last_last_last_act": jp.zeros(self._actuators),
+            "motor_targets": ctrl,
+            "action_history": jp.zeros(self._config.noise_config.action_max_delay * self._actuators),
+            "start_fallen": jp.zeros(()),
+        }
+        metrics = {}
+        for k, v in self._config.reward_config.scales.items():
+            metrics[f"reward/{k}" if v > 0 else f"cost/{k}"] = jp.zeros(())
+        metrics["airborne"] = jp.zeros(())
+        metrics["base_rise"] = jp.zeros(())
+        obs = self._get_obs(data, info, self._feet_contact(data))
+        reward, done = jp.zeros(2)
+        return mjx_env.State(data, obs, reward, done, metrics, info)
+
+    def step(self, state: mjx_env.State, action: jax.Array) -> mjx_env.State:
+        state.info["rng"], k_delay = jax.random.split(state.info["rng"])
+        hist = jp.roll(state.info["action_history"], self._actuators).at[: self._actuators].set(action)
+        state.info["action_history"] = hist
+        idx = jax.random.randint(k_delay, (1,), minval=self._config.noise_config.action_min_delay,
+                                 maxval=self._config.noise_config.action_max_delay)
+        a = hist.reshape((-1, self._actuators))[idx[0]]
+        targets = jp.clip(self._default_actuator + a * self._config.action_scale, self._ctrl_lo, self._ctrl_hi)
+        prev = state.info["motor_targets"]
+        lim = self._config.max_motor_velocity * self.dt
+        targets = jp.clip(targets, prev - lim, prev + lim)
+        data = mjx_env.step(self.mjx_model, state.data, targets, self.n_substeps)
+        state.info["motor_targets"] = targets
+        state.info["step"] += 1
+
+        contact = self._feet_contact(data)
+        obs = self._get_obs(data, state.info, contact)
+        up = self.get_gravity(data)[-1]
+        fell = (up < 0.5) | (data.qpos[self._floating_base_qpos_addr + 2] < 0.08)
+        done = fell | jp.isnan(data.qpos).any() | jp.isnan(data.qvel).any()
+
+        rewards = self._get_reward(data, action, state.info, contact)
+        rewards = {k: v * self._config.reward_config.scales[k] for k, v in rewards.items()}
+        # Clipped at 0 as in upstream's joystick.py: with termination on falls, negative steps would pay the policy to
+        # fall early.
+        reward = jp.clip(jp.nan_to_num(sum(rewards.values()) * self.dt), 0.0, 10000.0)
+
+        state.info["last_last_last_act"] = state.info["last_last_act"]
+        state.info["last_last_act"] = state.info["last_act"]
+        state.info["last_act"] = action
+        for k, v in rewards.items():
+            scale = self._config.reward_config.scales[k]
+            state.metrics[f"reward/{k}" if scale > 0 else f"cost/{k}"] = v
+        state.metrics["airborne"] = (~contact.any()).astype(jp.float32)
+        state.metrics["base_rise"] = data.qpos[self._floating_base_qpos_addr + 2] - getup.STAND_HEIGHT
+        return state.replace(data=data, obs=obs, reward=reward, done=done.astype(reward.dtype))
+
+    def _trigger(self, info):
+        since = info["step"] - info["trigger_step"]
+        on = (since >= 0) & (since < WINDOW_STEPS)
+        return on, since
+
+    def _get_obs(self, data: mjx.Data, info: dict[str, Any], contact: jax.Array) -> mjx_env.Observation:
+        obs = super()._get_obs(data, info, contact)
+        on, since = self._trigger(info)
+        extra = jp.array([on.astype(jp.float32), jp.clip(since * self.dt, -1.0, 2.0)])
+        return {"state": jp.hstack([obs["state"], extra]), "privileged_state": jp.hstack([obs["privileged_state"], extra])}
+
+    def _get_reward(self, data, action, info, contact):
+        on, since = self._trigger(info)
+        on = on.astype(jp.float32)
+        after = (since >= WINDOW_STEPS + 25).astype(jp.float32) + (since < 0).astype(jp.float32)  # settled phases
+        h = data.qpos[self._floating_base_qpos_addr + 2]
+        vz = data.qvel[self._floating_base_qvel_addr + 2]
+        airborne = (~contact.any()).astype(jp.float32)
+        qj = self.get_actuator_joints_qpos(data.qpos)
+        vj = self.get_actuator_joints_qvel(data.qvel)
+        up = self.get_gravity(data)[-1]
+        xy = data.qpos[self._floating_base_qpos_addr: self._floating_base_qpos_addr + 2]
+        return {
+            "alive": jp.ones(()),
+            "up_vel": on * jp.clip(vz, 0.0, 1.0),
+            "air": on * airborne,
+            "jump_height": on * jp.clip((h - 0.16) / 0.03, 0.0, 1.0),
+            "pose": after * jp.exp(-jp.sum(jp.square(qj - self._default_actuator)) / 0.25),
+            "still": after * jp.exp(-0.01 * jp.sum(jp.square(vj))),
+            "upright": jp.square((1.0 + up) / 2.0),
+            "hop_outside": (1.0 - on) * (1.0 - contact.astype(jp.float32).min()),
+            "drift": jp.sum(jp.square(xy - info["xy0"])) * 100.0,
+            "yaw_rate": jp.square(self.get_global_angvel(data)[2]),
+            "torques": cost_torques(data.actuator_force),
+            "action_rate": cost_action_rate(action, info["last_act"]),
+        }
