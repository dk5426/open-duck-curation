+"""Walker v2 for Open Duck Mini V2. Local addition, not upstream.
+
+Upstream's joystick task unchanged (same rewards, observations, action scale 0.25, imitation reference), with the
+domain randomizer replaced by getup.make_randomizer: upstream's randomization with the floor / torso ids looked up by
+name (upstream hardcodes geom 0 and the massless 'base' body) plus floor-surface randomization (surface_dr.py).
+"""
+
+from .joystick import Joystick, default_config  # noqa: F401
+from .getup import make_randomizer  # noqa: F401
