+class StepRecorder:
+    """Records every control step of the walker and the get-up to ~/duck_logs (2026-10-30), for comparing the robot
+    with the simulation. Does not change what the robot does. One file per segment: a segment starts when a mode
+    (walk / getup) starts stepping and ends when it stops (pause, abort, finish) for more than 0.5 s.
+
+    Kept cheap inside the 50 Hz loop: each step is copied into preallocated arrays (no Python lists to convert later).
+    Every 30 s only the new rows go to a small part file (<segment>.partNNN.npz), so a crash loses at most 30 s; when
+    the segment ends, the whole segment is written as one file and the parts are deleted. All file writing happens in
+    a low-priority background thread. Off with DUCK_RECORD=0; folder DUCK_RECORD_DIR (default ~/duck_logs)."""
+
+    GAP_S, FLUSH_S, CAP = 0.5, 30.0, 3000
+
+    def __init__(self, meta):
+        self.enabled = os.environ.get("DUCK_RECORD", "1") != "0"
+        self.dir = os.path.expanduser(os.environ.get("DUCK_RECORD_DIR", "~/duck_logs"))
+        self.meta = meta
+        self.mode, self.buf, self.n, self.last_t = None, None, 0, 0.0
+        self._lock = threading.Lock()  # one file write at a time, in order
+        if self.enabled:
+            os.makedirs(self.dir, exist_ok=True)
+            print(f"[REC] recording walker and get-up steps to {self.dir}", flush=True)
+
+    def add(self, mode, **row):
+        if not self.enabled:
+            return
+        now = time.monotonic()
+        if mode != self.mode or now - self.last_t > self.GAP_S:
+            self.close()
+            self.mode, self.n, self.parts, self.flushed_n, self.flushed_t = mode, 0, [], 0, now
+            self.path = os.path.join(self.dir, time.strftime("%Y%m%d_%H%M%S") + f"_{mode}.npz")
+            self.buf = {k: np.zeros((self.CAP,) + np.shape(v), dtype=np.float32) for k, v in row.items()}
+            self.buf["t"] = np.zeros(self.CAP)
+        if self.n == len(self.buf["t"]):  # grow (rare: every 60 s, then 120 s, ...)
+            self.buf = {k: np.concatenate([v, np.zeros_like(v)]) for k, v in self.buf.items()}
+        for k, v in row.items():
+            self.buf[k][self.n] = v
+        self.buf["t"][self.n] = now
+        self.n += 1
+        self.last_t = now
+        if now - self.flushed_t > self.FLUSH_S:
+            part = f"{self.path[:-4]}.part{len(self.parts):03d}.npz"
+            self.parts.append(part)
+            self._write(part, self._snapshot(self.flushed_n, self.n), [])
+            self.flushed_n, self.flushed_t = self.n, now
+
+    def idle(self):
+        if self.mode is not None and time.monotonic() - self.last_t > self.GAP_S:
+            self.close()
 
+    def close(self):
+        if self.mode is not None and self.n:
+            self._write(self.path, self._snapshot(0, self.n), self.parts)
+            print(f"[REC] {self.mode}: {self.n} steps -> {self.path}", flush=True)
+        self.mode, self.buf, self.n = None, None, 0
 
+    def _snapshot(self, a, b):
+        return {k: v[a:b].copy() for k, v in self.buf.items()}
+
+    def _write(self, path, arrays, delete_after):
+        mode, meta, lock = self.mode, repr(self.meta), self._lock
+
+        def work():
+            try:
+                os.setpriority(os.PRIO_PROCESS, threading.get_native_id(), 19)
+            except Exception:
+                pass
+            with lock:
+                self._write_now(path, mode, meta, arrays, delete_after)
+
+        Thread(target=work, daemon=True).start()
+
+    @staticmethod
+    def _write_now(path, mode, meta, arrays, delete_after):
+        try:
+            tmp = path + ".tmp.npz"
+            np.savez(tmp, mode=mode, meta=meta, **arrays)
+            os.replace(tmp, path)
+            for f in delete_after:
+                if os.path.exists(f):
+                    os.remove(f)
+        except Exception as e:  # never let logging take the robot down
+            print(f"[REC] write failed: {e}", flush=True)
+
