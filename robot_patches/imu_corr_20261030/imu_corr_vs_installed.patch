+    # Accelerometer at the home pose in the training model (MuJoCo imu site, 2026-10-30). The get-up's IMU correction
+    # rotates and scales the robot's reading so that its own standing reading (DUCK_IMU_STANDING_ACC) maps onto this.
+    SIM_STANDING_ACC = np.array([-1.22, -1.95, 9.54])
+
+    def _init_getup_imu_correction(self):
+        """DUCK_IMU_STANDING_ACC="ax,ay,az": the robot's raw accelerometer while standing still at home (median of a
+        few seconds, e.g. from a recorder log). Unset -> no correction. Used by the get-up only; the walker's
+        observations are not touched."""
+        self.g_imu_R, self.g_imu_scale = np.eye(3), 1.0
+        raw = os.environ.get("DUCK_IMU_STANDING_ACC", "").strip()
+        if not raw:
+            print("[GETUP] no IMU correction (DUCK_IMU_STANDING_ACC unset)", flush=True)
+            return
+        try:
+            robot = np.array([float(x) for x in raw.split(",")])
+            assert robot.shape == (3,) and 5.0 < np.linalg.norm(robot) < 15.0
+        except Exception:
+            print(f"[GETUP] bad DUCK_IMU_STANDING_ACC={raw!r}; no IMU correction", flush=True)
+            return
+        a = robot / np.linalg.norm(robot)
+        b = self.SIM_STANDING_ACC / np.linalg.norm(self.SIM_STANDING_ACC)
+        v, c = np.cross(a, b), float(np.dot(a, b))
+        vx = np.array([[0, -v[2], v[1]], [v[2], 0, -v[0]], [-v[1], v[0], 0]])
+        self.g_imu_R = np.eye(3) + vx + vx @ vx / (1 + c)  # rotates the robot's standing reading onto the model's
+        self.g_imu_scale = np.linalg.norm(self.SIM_STANDING_ACC) / np.linalg.norm(robot)
+        ang = np.degrees(np.arccos(np.clip(c, -1, 1)))
+        print(f"[GETUP] IMU correction: rotate {ang:.1f} deg, scale accel x{self.g_imu_scale:.3f} "
+              f"(robot standing reading {np.round(robot, 2).tolist()})", flush=True)
 
